# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Compiled binaries from go build
/bench
/validate
/emlcli
/[Bb]ench*

# CUDA build artifacts
cuda/*.o
cuda/eml_cuda_example

# Object files
*.o

# Editor/IDE
# .idea/
# .vscode/

# Test artifacts
*.txt
*.log
*.prof
benchmark_results.txt
/metal/eml_metal_shaders.air
/metal/eml_metal_shaders.metallib

# opencode config (personal)
opencode.json

# Node & WASM build artifacts, dependencies, and caches
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb
.pnpm-store/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
*.wasm
wasm/*.wasm
wasm/wasm_exec.js
wasm/run.js
.playwright/
playwright/
playwright-report/
test-results/

# Binaries and archives
bin/
/wasmbench
*.bin
*.a
*.lib
*.so.*

